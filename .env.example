# Copy this file to .env.local. Copy Project URL and anon/public key from
# Supabase Dashboard > Project Settings > API. Restart Vite after editing.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Never expose a service_role key in a VITE_* variable or frontend bundle.
# Configure QPay credentials only in trusted server/Edge Function secrets.
